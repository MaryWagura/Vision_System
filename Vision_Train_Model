 your datasets -> vision-common) so the import below works.","metadata":{}},{"cell_type":"code","source":"import os\nimport re\nimport sys\nimport cv2\nimport numpy as np\nimport joblib\n\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.metrics import classification_report\n\n# Confirm the attached dataset mounted where expected, then import it\nprint(os.listdir('/kaggle/input'))\nsys.path.append('/kaggle/input/datasets/maryclauds/vision-common')\n\nfrom vision_common import detect_marker, extract_shape_features","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T08:25:48.371987Z","iopub.execute_input":"2026-09-07T08:25:48.372627Z","iopub.status.idle":"2026-09-07T08:25:48.548429Z","shell.execute_reply.started":"2026-09-07T08:25:48.372587Z","shell.execute_reply":"2026-09-07T08:25:48.547661Z"}},"outputs":[{"name":"stdout","text":"['datasets']\n","output_type":"stream"}],"execution_count":6},{"cell_type":"markdown","source":"## 1. Dataset location","metadata":{}},{"cell_type":"code","source":"train_dir = '/kaggle/input/datasets/maryclauds/comprehensive-dataset/dataset'\n\npattern = re.compile(\n    r'^(?P<prefix>capture|train_capture|test_capture)_(?P<session>\\d+)(?:_(?P<aug>\\d+))?\\.\\w+$',\n    re.IGNORECASE\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T08:26:27.0884Z","iopub.execute_input":"2026-09-07T08:26:27.089003Z","iopub.status.idle":"2026-09-07T08:26:27.092902Z","shell.execute_reply.started":"2026-09-07T08:26:27.088974Z","shell.execute_reply":"2026-09-07T08:26:27.092215Z"}},"outputs":[],"execution_count":8},{"cell_type":"markdown","source":"## 2. Session label manifest\n\nOne label per capture SESSION, not per file. `SKIP` covers: marker-only\nsessions, multi-shape sessions (not usable with single-label-per-image\nextraction), interrupted/partial captures, and circle - which isn't one of\nthe three assigned shapes (square, star, hexagon) and must be excluded\nentirely per the project spec.","metadata":{}},{"cell_type":"code","source":"label_manifest = {\n    \"capture_1\": \"square\",          # 51 file(s), single shape\n    \"capture_2\": \"SKIP\",            # multi-shape frame (square+star)\n    \"capture_3\": \"SKIP\",            # multi-shape frame (square+star+hexagon)\n    \"capture_4\": \"SKIP\",            # multi-shape frame (square+star+hexagon)\n    \"capture_5\": \"SKIP\",            # multi-shape frame (2x square+star+hexagon)\n    \"capture_6\": \"SKIP\",            # multi-shape frame (2x square+star+hexagon)\n    \"capture_7\": \"square\",          # 51 file(s), single shape\n    \"capture_8\": \"hexagon\",         # 51 file(s), single shape\n    \"capture_9\": \"star\",            # 51 file(s), single shape\n    \"capture_10\": \"star\",           # 51 file(s), single shape\n    \"capture_11\": \"SKIP\",           # marker only, no shape\n    \"capture_12\": \"SKIP\",           # marker only, no shape (29/51 files - interrupted)\n    \"test_capture_1\": \"hexagon\",    # 11 file(s), single shape\n    \"test_capture_2\": \"star\",       # 11 file(s), single shape\n    \"test_capture_3\": \"SKIP\",       # circle - not an assigned shape\n    \"test_capture_4\": \"square\",     # 11 file(s), single shape\n    \"test_capture_5\": \"SKIP\",       # marker only, no shape\n    \"test_capture_6\": \"square\",     # 11 file(s), single shape\n    \"test_capture_7\": \"SKIP\",       # multi-shape frame (hexagon+circle)\n    \"test_capture_8\": \"square\",     # 11 file(s), single shape\n    \"test_capture_9\": \"square\",     # 11 file(s), single shape\n    \"train_capture_1\": \"hexagon\",   # 51 file(s), single shape\n    \"train_capture_2\": \"square\",    # 51 file(s), single shape\n    \"train_capture_3\": \"SKIP\",      # circle - not an assigned shape\n    \"train_capture_4\": \"star\",      # 51 file(s), single shape\n    \"train_capture_5\": \"SKIP\",      # marker only, no shape\n    \"train_capture_6\": \"SKIP\",      # marker only, no shape\n    \"train_capture_7\": \"SKIP\",      # marker only, no shape (1/51 files - interrupted)\n}\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T08:26:51.344887Z","iopub.execute_input":"2026-09-07T08:26:51.345336Z","iopub.status.idle":"2026-09-07T08:26:51.351319Z","shell.execute_reply.started":"2026-09-07T08:26:51.345308Z","shell.execute_reply":"2026-09-07T08:26:51.350558Z"}},"outputs":[],"execution_count":9},{"cell_type":"markdown","source":"## 3. Load + extract features (marker-aware, color-free)","metadata":{}},{"cell_type":"code","source":"def load_labeled_dataset(folder_path, manifest):\n    \"\"\"\n    Expands each labeled session to every file inside it, runs the shared\n    vision_common feature extraction (with the marker masked out when\n    present), and returns (X, y).\n    \"\"\"\n    X, y = [], []\n    skipped_unlabeled = 0\n    skipped_no_shape_found = 0\n\n    for filename in os.listdir(folder_path):\n        m = pattern.match(filename)\n        if not m:\n            continue\n\n        group_key = f\"{m.group('prefix').lower()}_{m.group('session')}\"\n        label = manifest.get(group_key, \"\").strip()\n\n        if not label or label.upper() == \"SKIP\":\n            skipped_unlabeled += 1\n            continue\n\n        image_path = os.path.join(folder_path, filename)\n        img = cv2.imread(image_path)\n        if img is None:\n            continue\n\n        marker = detect_marker(img)\n        features, _ = extract_shape_features(img, exclude_bbox=marker[\"bbox\"] if marker else None)\n\n        if features is None:\n            skipped_no_shape_found += 1\n            continue\n\n        X.append(features)\n        y.append(label)\n\n    print(f\"Loaded {len(X)} labeled samples.\")\n    print(f\"Skipped {skipped_unlabeled} files (session unlabeled or SKIP).\")\n    print(f\"Skipped {skipped_no_shape_found} files (labeled, but no valid shape contour found - spot-check these).\")\n\n    return np.array(X), np.array(y)\n\n\nX, y = load_labeled_dataset(train_dir, label_manifest)\n\nfor shape in np.unique(y):\n    print(f\"  {shape}: {int((y == shape).sum())} samples\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T08:27:15.149796Z","iopub.execute_input":"2026-09-07T08:27:15.150471Z","iopub.status.idle":"2026-09-07T08:31:46.784305Z","shell.execute_reply.started":"2026-09-07T08:27:15.15044Z","shell.execute_reply":"2026-09-07T08:31:46.783556Z"}},"outputs":[{"name":"stdout","text":"Loaded 298 labeled samples.\nSkipped 522 files (session unlabeled or SKIP).\nSkipped 176 files (labeled, but no valid shape contour found - spot-check these).\n  hexagon: 56 samples\n  square: 125 samples\n  star: 117 samples\n","output_type":"stream"}],"execution_count":10},{"cell_type":"markdown","source":"## 4. Stratified 80/20 split","metadata":{}},{"cell_type":"code","source":"X_train, X_test, y_train, y_test = train_test_split(\n    X, y, test_size=0.2, stratify=y, random_state=42\n)\n\nprint(f\"Train: {len(X_train)}  Test: {len(X_test)}\")\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 5. Train (class-weighted to offset the square/star/hexagon imbalance)\n","metadata":{}},{"cell_type":"code","source":"clf = RandomForestClassifier(\n    n_estimators=200,\n    class_weight=\"balanced\",\n    random_state=42\n)\nclf.fit(X_train, y_train)\n\ny_pred = clf.predict(X_test)\nprint(classification_report(y_test, y_pred))\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"**Check hexagon and star's individual precision/recall here, not just\noverall accuracy** - the test set is still square-heavy (same ratio as\ntraining), so a model quietly biased toward square can still post a\ndeceptively high top-line accuracy.","metadata":{}},{"cell_type":"markdown","source":"## 6. Save the model for `main_vision.py`","metadata":{}},{"cell_type":"code","source":"joblib.dump(clf, \"shape_classifier.pkl\")\nprint(\"Saved shape_classifier.pkl\")\n","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}